# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache

# Nuxt.js build / generate output
.nuxt
dist
.output

# pnpm
.pnpm-store

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Machine-local files stay off GitHub (docs/conventions/documentation.md)
*.local*

# The walk spec's run: Playwright's report and its failed screens
playwright-report/
test-results/

# The walks page's builds live in the credo root, outside every worktree; this guards a root that is a worktree
/walks/
.serena/

# The local environment's handle, data and build (pnpm local)
/.local-env/

# The docs site's build and Docusaurus's generated files (site/)
/site/build/
/site/.docusaurus/
