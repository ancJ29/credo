{
  "name": "credo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "check": "bash ops/gate.sh",
    "mock": "pnpm --filter @credo/ui run build:mock",
    "report": "pnpm --filter @credo/visual run report",
    "stack": "pnpm --filter @credo/scripts run stack",
    "demo": "pnpm --filter @credo/scripts run demo",
    "demo-files": "pnpm --filter @credo/scripts run demo-files",
    "fake": "pnpm --filter @credo/scripts run fake"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
