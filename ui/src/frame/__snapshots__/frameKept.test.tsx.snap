r" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></circle></svg></span></button></div></div></div><div style="--group-gap: var(--mantine-spacing-md); --group-align: center; --group-justify: flex-start; --group-wrap: wrap;" class="m_4081bf90 mantine-Group-root"><button style="--button-color: var(--mantine-color-white);" class="mantine-focus-auto mantine-active m_77c9d27d mantine-Button-root m_87cf2631 mantine-UnstyledButton-root" type="submit"><span class="m_80f1301b mantine-Button-inner"><span class="m_811560b9 mantine-Button-label">Give this password</span></span></button><button style="--button-bg: var(--mantine-color-default); --button-hover: var(--mantine-color-default-hover); --button-color: var(--mantine-color-default-color); --button-bd: calc(0.0625rem * var(--mantine-scale)) solid var(--mantine-color-default-border);" class="mantine-focus-auto mantine-active m_77c9d27d mantine-Button-root m_87cf2631 mantine-UnstyledButton-root" data-variant="default" type="button"><span class="m_80f1301b mantine-Button-inner"><span class="m_811560b9 mantine-Button-label">Make one for me</span></span></button></div></div></form></div></section><section style="padding: var(--mantine-spacing-md);" class="m_1b7284a3 mantine-Paper-root" data-with-border="true"><div style="--stack-gap: var(--mantine-spacing-md); --stack-align: stretch; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><h3 style="--title-fw: var(--mantine-h3-font-weight); --title-lh: var(--mantine-h3-line-height); --title-fz: var(--mantine-h3-font-size);" class="m_8a5d1357 mantine-Title-root" data-order="3">Change the code</h3><p style="color: var(--mantine-color-dimmed);" class="mantine-focus-auto m_b6d8b162 mantine-Text-root">From now on the person signs in with the new code, and is signed out on every device. The old code can be given again.</p><form><div style="--stack-gap: var(--mantine-spacing-sm); --stack-align: flex-start; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><div class="m_46b77525 mantine-InputWrapper-root mantine-TextInput-root" data-size="sm"><label style="font-weight: 500; --input-label-size: var(--mantine-font-size-sm);" class="m_8fdc1311 mantine-InputWrapper-label mantine-TextInput-label" data-size="sm" for="mantine-ID" id="mantine-ID-label">New code</label><div style="--input-height: var(--input-height-sm); --input-fz: var(--mantine-font-size-sm);" class="_wrapper_8efe7e m_6c018570 mantine-Input-wrapper mantine-TextInput-wrapper" data-variant="default" data-size="sm"><input class="_input_8efe7e m_8fb7ebe7 mantine-Input-input mantine-TextInput-input" data-variant="default" autocapitalize="characters" autocomplete="off" id="mantine-ID" value=""></div></div><button style="--button-bg: var(--mantine-color-default); --button-hover: var(--mantine-color-default-hover); --button-color: var(--mantine-color-default-color); --button-bd: calc(0.0625rem * var(--mantine-scale)) solid var(--mantine-color-default-border);" class="mantine-focus-auto mantine-active m_77c9d27d mantine-Button-root m_87cf2631 mantine-UnstyledButton-root" data-variant="default" type="submit"><span class="m_80f1301b mantine-Button-inner"><span class="m_811560b9 mantine-Button-label">Change the code</span></span></button></div></form></div></section><section style="padding: var(--mantine-spacing-md);" class="m_1b7284a3 mantine-Paper-root" data-with-border="true"><div style="--stack-gap: var(--mantine-spacing-md); --stack-align: stretch; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><h3 style="--title-fw: var(--mantine-h3-font-weight); --title-lh: var(--mantine-h3-line-height); --title-fz: var(--mantine-h3-font-size);" class="m_8a5d1357 mantine-Title-root" data-order="3">Email</h3><p style="color: var(--mantine-color-dimmed);" class="mantine-focus-auto m_b6d8b162 mantine-Text-root">A second name to sign in with, beside the code. No mail is ever sent to it, so it is not checked.</p><p class="mantine-focus-auto m_b6d8b162 mantine-Text-root">No email yet.</p><form><div style="--stack-gap: var(--mantine-spacing-sm); --stack-align: flex-start; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><div class="m_46b77525 mantine-InputWrapper-root mantine-TextInput-root" data-size="sm"><label style="font-weight: 500; --input-label-size: var(--mantine-font-size-sm);" class="m_8fdc1311 mantine-InputWrapper-label mantine-TextInput-label" data-size="sm" for="mantine-ID" id="mantine-ID-label">Email</label><div style="--input-height: var(--input-height-sm); --input-fz: var(--mantine-font-size-sm);" class="_wrapper_8efe7e m_6c018570 mantine-Input-wrapper mantine-TextInput-wrapper" data-variant="default" data-size="sm"><input class="_input_8efe7e m_8fb7ebe7 mantine-Input-input mantine-TextInput-input" data-variant="default" inputmode="email" autocomplete="off" autocapitalize="none" id="mantine-ID" value=""></div></div><div style="--group-gap: var(--mantine-spacing-md); --group-align: center; --group-justify: flex-start; --group-wrap: wrap;" class="m_4081bf90 mantine-Group-root"><button style="--button-bg: var(--mantine-color-default); --button-hover: var(--mantine-color-default-hover); --button-color: var(--mantine-color-default-color); --button-bd: calc(0.0625rem * var(--mantine-scale)) solid var(--mantine-color-default-border);" class="mantine-focus-auto mantine-active m_77c9d27d mantine-Button-root m_87cf2631 mantine-UnstyledButton-root" data-variant="default" type="submit"><span class="m_80f1301b mantine-Button-inner"><span class="m_811560b9 mantine-Button-label">Give this email</span></span></button></div></div></form></div></section><section style="padding: var(--mantine-spacing-md);" class="m_1b7284a3 mantine-Paper-root" data-with-border="true"><div style="--stack-gap: var(--mantine-spacing-md); --stack-align: stretch; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><h3 style="--title-fw: var(--mantine-h3-font-weight); --title-lh: var(--mantine-h3-line-height); --title-fz: var(--mantine-h3-font-size);" class="m_8a5d1357 mantine-Title-root" data-order="3">Sign in by QR code</h3><div style="--stack-gap: var(--mantine-spacing-sm); --stack-align: flex-start; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><p style="color: var(--mantine-color-dimmed);" class="mantine-focus-auto m_b6d8b162 mantine-Text-root">Show the code to the person on their phone. It signs one phone in, once, within 15 minutes. A new code cancels the last.</p><button style="--button-bg: var(--mantine-color-default); --button-hover: var(--mantine-color-default-hover); --button-color: var(--mantine-color-default-color); --button-bd: calc(0.0625rem * var(--mantine-scale)) solid var(--mantine-color-default-border);" class="mantine-focus-auto mantine-active m_77c9d27d mantine-Button-root m_87cf2631 mantine-UnstyledButton-root" data-variant="default" type="button"><span class="m_80f1301b mantine-Button-inner"><span class="m_811560b9 mantine-Button-label">Show a QR code</span></span></button></div></div></section><section style="padding: var(--mantine-spacing-md);" class="m_1b7284a3 mantine-Paper-root" data-with-border="true"><div style="--stack-gap: var(--mantine-spacing-md); --stack-align: stretch; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><h3 style="--title-fw: var(--mantine-h3-font-weight); --title-lh: var(--mantine-h3-line-height); --title-fz: var(--mantine-h3-font-size);" class="m_8a5d1357 mantine-Title-root" data-order="3">Lock</h3><div style="--stack-gap: var(--mantine-spacing-sm); --stack-align: flex-start; --stack-justify: flex-start;" class="m_6d731127 mantine-Stack-root"><p style="color: var(--mantine-color-dimmed);" class="mantine-focus-auto m_b6d8b162 mantine-Text-root">For someone who left. They are stopped at their next step and cannot sign in. Their record, code and password are kept, and you can unlock them when they return.</p><button style="--button-bg: var(--mantine-color-default); --button-hover: var(--mantine-color-default-hover); --button-color: var(--mantine-color-default-color); --button-bd: calc(0.0625rem * var(--mantine-scale)) solid var(--mantine-color-default-border);" class="mantine-focus-auto mantine-active m_77c9d27d mantine-Button-root m_87cf2631 mantine-UnstyledButton-root" data-variant="default" type="button"><span class="m_80f1301b mantine-Button-inner"><span class="m_811560b9 mantine-Button-label">Lock</span></span></button></div></div></section></div></div></div></div></div></main><footer style="--app-shell-footer-z-index: 100;" class="m_3840c879 mantine-AppShell-footer right-scroll-bar-position mantine-hidden-from-sm" data-with-border="true"><nav class="_bar_b1a4cd" aria-label="Menu"><a class="_barLink_b1a4cd" aria-label="Orders" href="/orders" data-discover="true"><span class="_barIcon_b1a4cd"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-clipboard-list"><path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2"></path><path d="M9 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2"></path><path d="M9 12l.01 0"></path><path d="M13 12l2 0"></path><path d="M9 16l.01 0"></path><path d="M13 16l2 0"></path></svg></span></a><a class="_barLink_b1a4cd" aria-label="Delivery requests" href="/deliveries" data-discover="true"><span class="_barIcon_b1a4cd"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-truck-delivery"><path d="M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path><path d="M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path><path d="M5 17h-2v-4m-1 -8h11v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5"></path><path d="M3 9l4 0"></path></svg></span></a><a class="_barLink_b1a4cd" aria-la