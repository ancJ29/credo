# The activity log on the box. ops/release.sh installs it as /etc/systemd/system/audit-backbone.service,
# after c-storage's own half of the release is done. The write key lives in
# /etc/audit-backbone/keys.env, root's alone: systemd reads that file before it starts the log as
# its own user, so the service never runs as root. /etc/audit-backbone/listen.env holds LISTEN_ADDR,
# the box's private address, which each release writes from the stack's BoxAddress; the writing
# listener binds it and the reading one stays on the box's loopback. The ports are set here, their
# one home: ops/stack.sh passes PORT to the template as AuditPort. One unit is one user: the
# store's Litestream cannot read this file, so the log's copy will run inside this unit.
[Unit]
Description=audit-backbone
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
DynamicUser=yes
StateDirectory=audit-backbone
# The database is the service's alone: SQLite makes its files at the process umask, and systemd's
# state directory defaults to 0755.
StateDirectoryMode=0700
UMask=0077
# PORT takes writes (the back end's door, opened to its group alone); OPEN_PORT takes reads and
# stays on loopback.
Environment=PORT=3184
Environment=OPEN_PORT=3185
Environment=DB_PATH=/var/lib/audit-backbone/audit-backbone.db
EnvironmentFile=/etc/audit-backbone/listen.env
EnvironmentFile=/etc/audit-backbone/keys.env
ExecStart=/opt/audit-backbone/credo-audit-backbone
# Always back, with no limit on tries: a manager that gives up after a few restarts leaves a
# crash loop down, and one that restarts nightly hides a leak.
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
