# c-storage on the box. ops/release.sh installs it as /etc/systemd/system/c-storage.service.
# The keys live in /etc/c-storage/keys.env, root's alone: systemd reads that file before it
# starts c-storage as its own user, so the service never runs as root. The login user owns
# nothing here. /etc/c-storage/listen.env holds LISTEN_ADDR, the box's private address, which each
# release writes from the stack's BoxAddress; the listener binds it and no other interface.
# The records live on a disk of their own, mounted where the state directory resolves
# (/var/lib/private/c-storage, as DynamicUser makes it), and Litestream copies each save to the box's
# path in the copy's bucket: it starts first and runs c-storage as its child (-exec), so the file's
# owner, the dynamic user, is the one that reads it. /etc/c-storage/copy.env holds COPY_URL and the
# Region, written by each release; the credentials are the box's role.
[Unit]
Description=c-storage
After=network-online.target
Wants=network-online.target
# The unit waits on the records disk's mount and does not start without it: c-storage makes a new,
# empty file wherever it is pointed, so a disk that failed to mount would leave it writing on the
# system disk, every save outside the copy.
RequiresMountsFor=/var/lib/private/c-storage
StartLimitIntervalSec=0

[Service]
DynamicUser=yes
StateDirectory=c-storage
# The database is the service's alone: SQLite makes its files at the process umask, and systemd's
# state directory defaults to 0755.
StateDirectoryMode=0700
UMask=0077
Environment=PORT=3181
Environment=DB_PATH=/var/lib/c-storage/c-storage.db
EnvironmentFile=/etc/c-storage/listen.env
EnvironmentFile=/etc/c-storage/copy.env
EnvironmentFile=/etc/c-storage/keys.env
ExecStart=/opt/c-storage/litestream replicate -config /opt/c-storage/litestream.yml -exec /opt/c-storage/c-storage
# Always back, with no limit on tries: a manager that gives up after a few restarts leaves a
# crash loop down, and one that restarts nightly hides a leak.
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
